{
  "name": "@carbonenginejs/tools-browser",
  "version": "0.1.5",
  "description": "Browser-facing CarbonEngineJS clients, remote readers, and application tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./audio": "./src/audio/index.js",
    "./chat": "./src/chat/index.js",
    "./demo-apps": "./src/demo-apps/index.js",
    "./demos": "./src/demos/index.js",
    "./diagrams": "./src/diagrams/index.js",
    "./fileindex": "./src/fileindex/index.js",
    "./market": "./src/market/index.js",
    "./market/ui": "./src/market/ui/index.js",
    "./market/ui.css": "./src/market/ui/market-window.css",
    "./perobject": "./src/perobject/index.js",
    "./realtime": "./src/realtime/index.js",
    "./realtime/wire": "./src/realtime/CjsRealtimeProtocol.js",
    "./ship-show-info": "./src/ship-show-info/index.js",
    "./ship-show-info/ui": "./src/ship-show-info/ui/index.js",
    "./ship-show-info/ui.css": "./src/ship-show-info/ui/ship-show-info.css",
    "./ship-tree": "./src/ship-tree/index.js",
    "./ship-tree/ui": "./src/ship-tree/ui/index.js",
    "./ship-tree/ui.css": "./src/ship-tree/ui/ship-tree.css",
    "./theme/eve.css": "./src/theme/eve.css"
  },
  "sideEffects": [
    "./src/market/ui/market-window.css",
    "./src/ship-show-info/ui/ship-show-info.css",
    "./src/ship-tree/ui/ship-tree.css",
    "./src/theme/eve.css"
  ],
  "scripts": {
    "lint": "node scripts/lint_package.js",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@carbonenginejs/runtime-audio": "^0.3.3",
    "@carbonenginejs/runtime-resource": "^0.22.0",
    "@carbonenginejs/runtime-trinity": "^0.11.2",
    "@carbonenginejs/runtime-utils": "^0.1.6"
  },
  "keywords": [
    "carbonenginejs",
    "tools-browser",
    "browser",
    "audio",
    "chat",
    "market",
    "ship-show-info",
    "ship-tree",
    "diagrams",
    "fileindex",
    "realtime",
    "websocket"
  ],
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonenginejs/tools-browser.git"
  },
  "homepage": "https://github.com/carbonenginejs/tools-browser#readme",
  "bugs": {
    "url": "https://github.com/carbonenginejs/tools-browser/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
