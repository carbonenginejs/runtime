    "./math/vertex": "./src/global/math/vertex.js",
    "./math/mesh": "./src/global/math/mesh.js",
    "./math/tangent": "./src/global/math/tangent.js",
    "./math/geometry": "./src/global/math/geometry/index.js",
    "./utils": "./src/global/utils/index.js",
    "./utils/arrays": "./src/global/utils/arrays.js",
    "./utils/bytes": "./src/global/utils/bytes.js",
    "./utils/compression": "./src/global/utils/compression.js",
    "./utils/errors": "./src/global/utils/errors/index.js",
    "./utils/is": "./src/global/utils/is.js",
    "./utils/json": "./src/global/utils/json.js",
    "./utils/lookup": "./src/global/utils/lookup.js",
    "./utils/object": "./src/global/utils/object.js",
    "./utils/path": "./src/global/utils/path.js",
    "./utils/resfile": "./src/global/utils/resFile.js",
    "./utils/text": "./src/global/utils/text.js",
    "./utils/validation": "./src/global/utils/validation.js",
    "./consts": "./src/global/consts/index.js",
    "./consts/trinity": "./src/global/consts/trinity.js",
    "./consts/media": "./src/global/consts/media/index.js",
    "./consts/graphics": "./src/global/consts/graphics/index.js",
    "./consts/render-context": "./src/global/consts/renderContext/index.js",
    "./consts/audio": "./src/global/consts/audio/index.js",
    "./consts/shader": "./src/global/consts/shader/index.js",
    "./consts/d3d": "./src/global/consts/d3d/index.js",
    "./consts/webgpu": "./src/global/consts/webgpu/index.js",
    "./contracts": "./src/global/contracts/index.js",
    "./schema": "./src/global/schema/index.js",
    "./schema/types": "./src/global/schema/types/index.js",
    "./model": "./src/global/model/index.js",
    "./model/document": "./src/global/model/document/index.js",
    "./model/hydration": "./src/global/model/document/hydrationAdapter.js",
    "./model/lifecycle": "./src/global/model/lifecycle/index.js",
    "./resource": "./src/resource/index.js",
