{
  "name": "@carbonenginejs/tools-browser",
  "version": "0.1.3",
  "description": "Browser-facing CarbonEngineJS clients, remote readers, and application tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./audio": "./src/audio/index.js",
    "./chat": "./src/chat/index.js",
    "./fileindex": "./src/fileindex/index.js",
    "./perobject": "./src/perobject/index.js",
    "./realtime": "./src/realtime/index.js",
    "./realtime/wire": "./src/realtime/CjsRealtimeProtocol.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node scripts/lint_package.js",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@carbonenginejs/runtime-audio": "^0.3.0",
    "@carbonenginejs/runtime-resource": "^0.16.0",
    "@carbonenginejs/runtime-trinity": "^0.11.0",
    "@carbonenginejs/runtime-utils": "^0.1.6"
  },
  "keywords": [
    "carbonenginejs",
    "tools-browser",
    "browser",
    "audio",
    "chat",
    "fileindex",
    "realtime",
    "websocket"
