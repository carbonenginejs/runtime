{
  "name": "@carbonenginejs/runtime-character",
  "version": "0.1.1",
  "private": true,
  "description": "GPU-free, I/O-free character composition graph and data contracts for CarbonEngineJS.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:npm": "node scripts/build_npm.js && rollup -c",
    "proof:decorators": "node scripts/proof_decorator_transform.js",
    "test": "npm run build:npm && node --test test/*.test.js",
    "lint": "npm run build:npm && node --check npm/dist/index.js && node --check test/runtime-character.test.js && node --check scripts/build_npm.js && node --check scripts/proof_decorator_transform.js && node --check rollup.config.mjs",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "carbonenginejs",
    "character",
    "paperdoll",
    "avatar",
    "graph"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "rollup": "^4.62.2"
  },
  "dependencies": {
    "@carbonenginejs/core-math": "file:../core-math",
    "@carbonenginejs/core-types": "file:../core-types"
  },
  "publishConfig": {
    "access": "public"
  }
}
