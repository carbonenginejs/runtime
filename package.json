  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonenginejs/tools-browser.git"
  },
  "homepage": "https://github.com/carbonenginejs/tools-browser#readme",
  "bugs": {
    "url": "https://github.com/carbonenginejs/tools-browser/issues"
  },
  "publishConfig": {
    "access": "public"
  }
