{
  "name": "@carbonenginejs/tools-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-facing CarbonEngineJS clients, remote readers, and application tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./chat": "./src/chat/index.js",
    "./fileindex": "./src/fileindex/index.js",
    "./realtime": "./src/realtime/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
