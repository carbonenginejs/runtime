{
  "name": "@carbonenginejs/runtime-resource",
  "version": "0.12.2",
  "private": true,
  "description": "CarbonEngineJS resource lifecycle, cache, source, and object loading contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./resource": "./src/resource/index.js",
    "./resource/audio": "./src/resource/audio/index.js",
    "./resource/geometry": "./src/resource/geometry/index.js",
    "./resource/geometry/granny": "./src/resource/geometry/granny/index.js",
    "./resource/shader": "./src/resource/shader/index.js",
    "./resource/texture": "./src/resource/texture/index.js",
    "./worker": "./src/worker/CjsResManWorker.js",
    "./format": "./src/format/index.js",
    "./formats": "./src/formats/index.js",
    "./formats/black": "./src/formats/black/index.js",
    "./formats/black/schema": "./src/formats/black/core/blackSchema.js",
    "./formats/black/enums": "./src/formats/black/core/blackEnums.js",
    "./formats/black/version": "./src/formats/black/core/blackVersion.js",
    "./formats/bnk": "./src/formats/bnk/index.js",
    "./formats/cmf": "./src/formats/cmf/index.js",
    "./formats/dds": "./src/formats/dds/index.js",
    "./formats/dxbc": "./src/formats/dxbc/index.js",
    "./formats/hlsl": "./src/formats/hlsl/index.js",
    "./formats/webgl": "./src/formats/webgl/index.js",
    "./formats/webgpu": "./src/formats/webgpu/index.js",
    "./formats/fbx": "./src/formats/fbx/index.js",
    "./formats/flac": "./src/formats/flac/index.js",
    "./formats/gif": "./src/formats/gif/index.js",
    "./formats/gltf": "./src/formats/gltf/index.js",
    "./formats/gr2": "./src/formats/gr2/index.js",
    "./formats/jpeg": "./src/formats/jpeg/index.js",
    "./formats/mp3": "./src/formats/mp3/index.js",
    "./formats/mp4": "./src/formats/mp4/index.js",
    "./formats/obj": "./src/formats/obj/index.js",
    "./formats/ogg": "./src/formats/ogg/index.js",
    "./formats/pickle": "./src/formats/pickle/index.js",
    "./formats/png": "./src/formats/png/index.js",
    "./formats/red": "./src/formats/red/index.js",
    "./formats/red/schema": "./src/formats/red/core/blackDefinitions.js",
    "./formats/stl": "./src/formats/stl/index.js",
    "./formats/tga": "./src/formats/tga/index.js",
    "./formats/wav": "./src/formats/wav/index.js",
    "./formats/webm": "./src/formats/webm/index.js",
    "./formats/webp": "./src/formats/webp/index.js",
    "./formats/wem": "./src/formats/wem/index.js",
    "./formats/yaml": "./src/formats/yaml/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node scripts/lint_package.js",
    "build:npm": "npm run lint && node scripts/build_npm.js && rollup -c",
    "proof:decorators": "node scripts/proof_decorator_transform.js",
    "metadata:hlsl": "node scripts/formats/hlsl/metadata.js metadata",
    "package:effect": "node scripts/formats/webgpu/package-effect.js",
    "qualify:effects": "node scripts/formats/webgpu/qualify-effect-pairs.js",
    "qualify:matrix": "node scripts/formats/webgpu/qualify-effect-matrix.js",
    "package:webgl": "node scripts/formats/webgl/packageTr2WebglEffect.js",
    "validate:webgl2": "node scripts/formats/webgl/validateWebgl2Effect.js",
    "check": "npm run build:npm && npm run proof:decorators",
    "test": "npm run check && node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@carbonenginejs/runtime-utils": "^0.1.3",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "rollup": "^4.62.2"
  },
  "dependencies": {
    "meshoptimizer": "^1.2.0",
    "yaml": "^2.4.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
