{
  "name": "@carbonenginejs/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Unpublished consolidation destination for the browser-safe CarbonEngineJS runtime, renderer engines, and browser tools.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./global": "./src/global/index.js",
    "./math": "./src/global/math/index.js",
    "./math/scalar": "./src/global/math/scalar.js",
    "./math/num": "./src/global/math/num.js",
    "./math/vec2": "./src/global/math/vec2.js",
    "./math/vec3": "./src/global/math/vec3.js",
    "./math/vec4": "./src/global/math/vec4.js",
    "./math/quat": "./src/global/math/quat.js",
    "./math/mat3": "./src/global/math/mat3.js",
    "./math/mat4": "./src/global/math/mat4.js",
    "./math/box3": "./src/global/math/box3.js",
    "./math/tri3": "./src/global/math/tri3.js",
    "./math/lne3": "./src/global/math/lne3.js",
    "./math/pln": "./src/global/math/pln.js",
    "./math/ray3": "./src/global/math/ray3.js",
    "./math/sph3": "./src/global/math/sph3.js",
    "./math/pool": "./src/global/math/pool.js",
    "./math/utils": "./src/global/math/utils.js",
    "./math/noise": "./src/global/math/noise.js",
